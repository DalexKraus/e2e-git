#!/bin/bash
# Encrypts files defined in .gitattributes with filter=crypt
# Stores encrypted version in index; keeps decrypted file locally

PIN_FILE="/tmp/fido2_pin_cache"

get_pin() {
    if [ -f "$PIN_FILE" ]; then
        cat "$PIN_FILE"
        return
    fi

    pin=$(pinentry-gtk-2 --title "FIDO2 PIN" --description "Bitte gib deinen FIDO2-PIN ein." <<EOF | grep ^D | cut -c3-
GETPIN
EOF
)
    if [ -n "$pin" ]; then
        echo "$pin" > "$PIN_FILE"
    fi
    echo "$pin"
}

# Get staged files that have 'filter=crypt' in .gitattributes
FILES_TO_ENCRYPT=$(
    git diff --cached --name-only --diff-filter=ACM |
    while read -r file; do
        if git check-attr filter -- "$file" | grep -q 'filter: crypt'; then
            echo "$file"
        fi
    done
)

if [ -z "$FILES_TO_ENCRYPT" ]; then
    exit 0
fi

echo "Encrypting files for Git index..."

PIN=$(get_pin)
if [ -z "$PIN" ]; then
    echo "No PIN provided, aborting commit." >&2
    exit 1
fi

for file in $FILES_TO_ENCRYPT; do
    if [ -f "$file" ]; then
        echo "Encrypting for index: $file"
        TMP_BLOB=$(mktemp)

        if cat "$file" | ./fido2-derive --mode=enc --pin="$PIN" > "$TMP_BLOB"; then
            # Create blob object from encrypted content and get its hash
            BLOB_HASH=$(git hash-object -w "$TMP_BLOB")

            # Get file mode (usually 100644)
            FILE_MODE=$(git ls-files -s "$file" | awk '{ print $1 }')

            # Update index with encrypted blob - don't touch working file
            git update-index --cacheinfo "$FILE_MODE","$BLOB_HASH","$file"
        else
            echo "Encryption failed for $file" >&2
            rm -f "$TMP_BLOB"
            exit 1
        fi

        rm -f "$TMP_BLOB"
    fi
done

echo "Encrypted files staged. Working files remain decrypted."

exit 0

