#!/bin/bash
# .git/hooks/pre-commit
# This hook encrypts files before committing

PIN_FILE="/tmp/fido2_pin_cache"

get_pin() {
    if [ -f "$PIN_FILE" ]; then
        cat "$PIN_FILE"
        return
    fi
    
    pin=$(pinentry-gtk-2 --title "FIDO2 PIN" --description "Bitte gib deinen FIDO2-PIN ein." <<EOF | grep ^D | cut -c3-
GETPIN
EOF
)
    
    if [ -n "$pin" ]; then
        echo "$pin" > "$PIN_FILE"
    fi
    echo "$pin"
}

# Get list of files to be committed that match our pattern
FILES_TO_ENCRYPT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.txt$')

if [ -z "$FILES_TO_ENCRYPT" ]; then
    # No .txt files to encrypt, exit successfully
    exit 0
fi

echo "Encrypting files before commit..."

# Get PIN once for all operations
PIN=$(get_pin)
if [ -z "$PIN" ]; then
    echo "No PIN provided, aborting commit." >&2
    exit 1
fi

# Track if we need to re-add any files
RESTAGE_NEEDED=false

# Encrypt each file
for file in $FILES_TO_ENCRYPT; do
    if [ -f "$file" ]; then
        echo "Encrypting: $file"
        
        # Create a temporary file for encryption
        temp_file=$(mktemp)
        
        # Encrypt the file content
	if cat "$file" | ./fido2-derive --mode=enc --pin="$PIN" > "$temp_file"; then
            # Replace the original file with encrypted version
            mv "$temp_file" "$file"
            # Re-stage the encrypted file
            git add "$file"
            RESTAGE_NEEDED=true
        else
            echo "Failed to encrypt $file" >&2
            rm -f "$temp_file"
            exit 1
        fi
    fi
done

if [ "$RESTAGE_NEEDED" = true ]; then
    echo "Files encrypted and re-staged for commit."
fi

exit 0

