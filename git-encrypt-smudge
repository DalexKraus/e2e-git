#!/bin/bash
# This runs when checking out files (smudge filter)
# It should decrypt the content and output to stdout

PIN="$FIDO2_PIN"  # Set this environment variable
if [ -z "$PIN" ]; then
    echo "Error: FIDO2_PIN environment variable not set" >&2
    exit 1
fi

# Read encrypted content from stdin, decrypt, output to stdout  
./fido2-derive --mode=dec --pin="$PIN"
