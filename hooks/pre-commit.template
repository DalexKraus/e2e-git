#!/bin/bash
# .git/hooks/pre-commit
# Encrypts files with filter=crypt before committing, in place

# Get staged files (Added/Copied/Modified) that have 'filter=crypt' in .gitattributes
FILES_TO_ENCRYPT=$(
    git diff --cached --name-only --diff-filter=ACM |
    while read -r file; do
        if git check-attr filter -- "$file" | grep -q 'filter: crypt'; then
            echo "$file"
        fi
    done
)

if [ -z "$FILES_TO_ENCRYPT" ]; then
    # No files to encrypt
    exit 0
fi

echo "[pre-commit] Encrypting files..."

if {{BINARY_PATH}} --fido-device={{DEVICE_ID}} --mode=enc --pinentry={{PINENTRY_METHOD}} $FILES_TO_ENCRYPT; then
    echo "[pre-commit] All files encrypted successfully"
    # Re-stage all modified files
    for file in $FILES_TO_ENCRYPT; do
        git add "$file"
    done
    echo "[pre-commit] Files encrypted and re-staged."
else
    echo "[pre-commit] Encryption failed - all files restored to original state" >&2
    exit 1
fi

exit 0
